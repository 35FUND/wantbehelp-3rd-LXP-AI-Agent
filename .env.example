GEMINI_API_KEY=your_gemini_api_key
MODEL_NAME=gemini-2.5-flash

# EC2에서는 IAM Role 사용을 권장한다. 로컬에서만 필요하면 입력한다.
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_SESSION_TOKEN=
AWS_REGION=ap-northeast-2
S3_BUCKET_NAME=your-s3-bucket
SHORTS_DIR=shorts/

DATABASE_URL=mysql+aiomysql://user:password@127.0.0.1:3306/database_name

APP_HOST=0.0.0.0
APP_PORT=8000
APP_RELOAD=false

INSPECTION_PENDING_STATUS=PENDING
SHORTS_APPROVED_STATUS=PUBLISHED
SHORTS_REJECTED_STATUS=REJECTED

INSPECTOR_JOB_INTERVAL_DAYS=0
INSPECTOR_JOB_INTERVAL_HOURS=0
INSPECTOR_JOB_INTERVAL_MINUTES=1
INSPECTOR_JOB_INTERVAL_SECONDS=0
